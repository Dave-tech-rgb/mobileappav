{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": [
      "nativewind/types",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "expo-camera": ["node_modules/expo-camera"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app.d.ts"
  ],
  "exclude": [
    "node_modules",
    "autovisiondrf"
  ]
}
